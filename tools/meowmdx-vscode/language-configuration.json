{
  "comments": { "blockComment": ["<!--", "-->"] },
  "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "`", "close": "`" },
    { "open": "\"", "close": "\"" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["`", "`"], ["*", "*"], ["_", "_"], ["~", "~"],
    ["[", "]"], ["(", ")"], ["\"", "\""]
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*[-*+]\\s+\\[[ xX]\\]\\s.*$",
      "action": { "indent": "none", "appendText": "- [ ] " }
    },
    {
      "beforeText": "^\\s*([-*+])\\s+.*$",
      "action": { "indent": "none", "appendText": "- " }
    }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
