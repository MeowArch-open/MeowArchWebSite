# MeowArch API — environment configuration
# Copy to .env and adjust. The server boots without any of these (dev mode:
# in-memory DB + local disk blob storage + auto-generated admin token).

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (pick ONE) ---
# Static shared token (recommended for CI/CD and personal use).
# curl -H "Authorization: Bearer $ADMIN_SECRET_KEY" ...
ADMIN_SECRET_KEY=
# Or JWT: tokens must be signed with this secret and contain role:"admin".
JWT_SECRET=

# --- Database ---
# Leave empty for the in-memory store (dev mode).
# Works with MongoDB Atlas, self-hosted MongoDB, or Azure Cosmos DB for MongoDB (vCore).
# Notes:
#   - Percent-encode special chars in the password: @ -> %40 (e.g. p@ss -> p%40ss)
#   - Append /dbname to choose the database (e.g. /meowarch), otherwise it defaults to "test"
#   - Example: mongodb+srv://user:p%40ss@cluster.example.com/meowarch?retryWrites=true&w=majority
MONGODB_URI=

# --- Azure Blob storage ---
# Leave empty for local disk storage under api/.data/blob/ (dev mode).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=release
# Optional override for the public download base URL (default: https://<account>.blob.core.windows.net)
AZURE_PUBLIC_BASE_URL=

# --- Local mode URLs ---
# Base URL used to build publicUrl / uploadUrl when running without Azure.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- Upload ticket ---
UPLOAD_TICKET_TTL_SECONDS=3600
